# ─────────────────────────────────────────────
# Diamond Booking — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ─────────────────────────────────────────────

# ── Database ──────────────────────────────────
# Get from Supabase: Settings > Database > Connection string (URI)
# Or from Neon: Dashboard > Connection Details
DATABASE_URL="postgresql://user:password@host:5432/diamond_booking?sslmode=require"

# ── NextAuth ──────────────────────────────────
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-random-32-char-string"
NEXTAUTH_URL="https://www.diamond-booking.com"

# ── Super Admin (KEEP SECRET) ─────────────────
# These are used only by the seed script to create the first admin account.
# After seeding, change the password in the app.
SUPER_ADMIN_EMAIL="admin@yourdomain.com"
SUPER_ADMIN_PASSWORD="change-this-to-a-strong-password"

# ── Stripe ────────────────────────────────────
# Test keys from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
# From: Stripe Dashboard > Developers > Webhooks > your endpoint
STRIPE_WEBHOOK_SECRET="whsec_..."

# Price IDs (Products → Prices). Required by /api/billing/create-checkout
STRIPE_PRICE_STARTER_MONTHLY="price_..."
STRIPE_PRICE_STARTER_YEARLY="price_..."
STRIPE_PRICE_PRO_MONTHLY="price_..."
STRIPE_PRICE_PRO_YEARLY="price_..."
STRIPE_PRICE_ENTERPRISE_MONTHLY="price_..."
STRIPE_PRICE_ENTERPRISE_YEARLY="price_..."

# ── Email (Resend) ────────────────────────────
# From: https://resend.com/api-keys
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="noreply@yourdomain.com"
RESEND_FROM_NAME="Diamond Booking"

# ── Google OAuth ─────────────────────────────
# From: https://console.cloud.google.com > APIs & Services > Credentials
GOOGLE_OAUTH_ENABLED="false"
GOOGLE_CLIENT_ID="..."
GOOGLE_CLIENT_SECRET="..."

# ── Address Autocomplete (Google Places) ─────
# Server-only key used by /api/address/* routes
GOOGLE_MAPS_API_KEY="..."

# ── File Uploads (Uploadthing) ────────────────
# From: https://uploadthing.com/dashboard
UPLOADTHING_SECRET="sk_live_..."
UPLOADTHING_APP_ID="..."

# ── App ───────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://www.diamond-booking.com"
NEXT_PUBLIC_APP_NAME="Diamond Booking"

TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_FROM_NUMBER="+15551234567"

AUTOMATIONS_CRON_SECRET="replace-with-random-32-char-string"
CRON_SECRET="replace-with-random-32-char-string"

# ── Optional: Error Tracking ──────────────────
# SENTRY_DSN=""
# SENTRY_ORG=""
# SENTRY_PROJECT=""
